# Copy this file to .env.local and replace the example values.
# Never commit .env.local or expose server secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp contact number in international format, digits only (e.g. 51987654321)
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=

# MongoDB Atlas: use Connect > Drivers to get the URI for your own cluster.
# URL-encode special characters in the database username/password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/olive?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
